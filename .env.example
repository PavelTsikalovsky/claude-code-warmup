# Required: Long-lived Claude Code OAuth token
# Generate it by running: claude setup-token
# It starts with sk-ant-oat01-... and is valid for 1 year.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Optional: Custom warm-up message sent to Claude at the scheduled time
WARMUP_MESSAGE=

# Required for cron endpoint auth.
# Generate your own value: openssl rand -hex 32
# In Vercel add the same value in Project Settings -> Environment Variables.
CRON_SECRET=replace-with-random-secret
